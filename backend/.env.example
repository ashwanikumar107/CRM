PORT=10000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ai_crm

# JWT Auth (generate strong random strings, e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Gemini AI (get key from https://aistudio.google.com/app/apikey)
# Keys start with "AIza..."
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Channel Service
CHANNEL_SERVICE_URL=http://localhost:6000
SELF_URL=http://localhost:10000

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000
